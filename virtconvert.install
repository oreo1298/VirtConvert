post_install() {
  echo ":: VirtConvert installed. Start it from your application menu, or run: virtconvert"
  echo ":: Command line: virtconvert --help"
}

post_upgrade() {
  post_install
}

post_remove() {
  echo ":: Your settings in ~/.config/virtconvert were kept; delete the folder if you like."
  echo ":: Your disk images were not touched."
}
