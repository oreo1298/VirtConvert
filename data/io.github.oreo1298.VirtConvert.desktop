[Desktop Entry]
Type=Application
Name=VirtConvert&Create
GenericName=Virtual Disk Converter
Comment=Convert and create virtual disks for VirtualBox, Hyper-V, VMware and QEMU/KVM
Exec=virtconvert %F
Icon=io.github.oreo1298.VirtConvert
Terminal=false
Categories=System;Emulator;Qt;
Keywords=vhd;vhdx;avhdx;vdi;vmdk;qcow2;qed;ova;ovf;virtualbox;hyper-v;hyperv;vmware;qemu;kvm;proxmox;qemu-img;disk;image;convert;create;new disk;virtual machine;appliance;checkpoint;snapshot;
MimeType=application/x-vhd-disk;application/x-vhdx-disk;application/x-vmdk-disk;application/x-virtualbox-vdi;application/x-virtualbox-vhd;application/x-virtualbox-vhdx;application/x-virtualbox-vmdk;application/x-qemu-disk;application/x-virtualbox-qcow2;application/x-virtualbox-qed;application/x-virtualbox-ova;application/x-virtualbox-ovf;application/x-raw-disk-image;
StartupNotify=true
StartupWMClass=virtconvert
